{
  "formId": "board-basic",
  "formName": "게시판 기본 양식",
  "category": "board",
  "version": "1.0.0",
  "sections": [
    {
      "id": "section-title",
      "title": "📋 제목 정보",
      "description": "게시물의 기본 제목 정보를 입력합니다",
      "backgroundColor": "#f0f2f5",
      "fields": [
        {
          "id": "category",
          "name": "category",
          "label": "카테고리",
          "type": "select",
          "required": true,
          "defaultValue": "일반공지",
          "placeholder": "카테고리를 선택하세요",
          "width": "200px",
          "options": [
            { "label": "일반공지", "value": "일반공지" },
            { "label": "중요공지", "value": "중요공지" },
            { "label": "긴급공지", "value": "긴급공지" }
          ],
          "validation": {
            "required": true,
            "message": "카테고리를 선택하세요"
          }
        },
        {
          "id": "title",
          "name": "title",
          "label": "제목",
          "type": "text",
          "required": true,
          "placeholder": "공지사항 제목을 입력하세요",
          "size": "large",
          "maxLength": 200,
          "validation": {
            "required": true,
            "message": "제목을 입력하세요",
            "min": 5,
            "max": 200
          }
        }
      ]
    },
    {
      "id": "section-header",
      "title": "📌 헤더 정보",
      "description": "게시물의 메타 정보를 입력합니다",
      "backgroundColor": "#fff7e6",
      "fields": [
        {
          "id": "author",
          "name": "author",
          "label": "작성자",
          "type": "text",
          "required": false,
          "defaultValue": "관리자",
          "placeholder": "작성자명",
          "disabled": false
        },
        {
          "id": "displayPeriod",
          "name": "displayPeriod",
          "label": "공지기간",
          "type": "daterange",
          "required": false,
          "placeholder": ["시작일", "종료일"],
          "format": "YYYY-MM-DD"
        },
        {
          "id": "isPinned",
          "name": "isPinned",
          "label": "상단고정",
          "type": "checkbox",
          "required": false,
          "defaultValue": false,
          "options": [
            { "label": "이 게시물을 상단에 고정합니다", "value": true }
          ]
        }
      ]
    },
    {
      "id": "section-body",
      "title": "📝 본문 내용",
      "description": "게시물의 주요 내용을 작성합니다",
      "backgroundColor": "#f6ffed",
      "fields": [
        {
          "id": "content",
          "name": "content",
          "label": "내용",
          "type": "richtext",
          "required": true,
          "placeholder": "공지사항 내용을 작성하세요...",
          "minHeight": "400px",
          "validation": {
            "required": true,
            "message": "내용을 입력하세요",
            "min": 10
          }
        }
      ]
    },
    {
      "id": "section-footer",
      "title": "📎 첨부 및 메타정보",
      "description": "첨부파일 및 추가 메타정보를 입력합니다",
      "backgroundColor": "#fff1f0",
      "fields": [
        {
          "id": "attachments",
          "name": "attachments",
          "label": "첨부파일",
          "type": "upload",
          "required": false,
          "placeholder": "파일을 선택하거나 드래그하세요",
          "maxCount": 5,
          "maxSize": 10485760,
          "accept": ".pdf,.doc,.docx,.xls,.xlsx,.zip,.jpg,.png",
          "disabled": true,
          "disabledMessage": "파일 업로드 기능 (추후 구현)"
        },
        {
          "id": "tags",
          "name": "tags",
          "label": "태그",
          "type": "tags",
          "required": false,
          "placeholder": "태그를 입력하세요",
          "mode": "tags",
          "options": [
            { "label": "시스템점검", "value": "시스템점검" },
            { "label": "업데이트", "value": "업데이트" },
            { "label": "안내", "value": "안내" },
            { "label": "교육", "value": "교육" },
            { "label": "이벤트", "value": "이벤트" }
          ]
        },
        {
          "id": "notifyUsers",
          "name": "notifyUsers",
          "label": "알림 발송",
          "type": "checkbox",
          "required": false,
          "defaultValue": false,
          "options": [
            { "label": "등록 시 전체 사용자에게 알림을 발송합니다", "value": true }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "createdAt": "2026-02-06T00:00:00.000Z",
    "updatedAt": "2026-02-06T00:00:00.000Z",
    "author": "System Admin",
    "description": "게시판 기본 작성 양식"
  }
}
