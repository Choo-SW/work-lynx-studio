{
  "name": "lynx-studio-form-builder",
  "version": "0.1.0",
  "private": true,
  "description": "TCCINS Work Lynx Studio - LowCode Form Builder Module for Progressive Disclosure based SaaS-Legacy Integration",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:clean": "rimraf .next && cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:turbo": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rimraf .next",
    "diagnose": "node scripts/diagnose-windows.js"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@xyflow/react": "^12.10.0",
    "antd": "^6.1.4",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactflow": "^11.11.4",
    "survey-core": "^1.12.16",
    "survey-creator-core": "^1.12.58",
    "survey-creator-react": "^1.12.58",
    "survey-react-ui": "^1.12.16"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
